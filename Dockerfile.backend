FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV LLM_BACKEND=ollama
ENV OLLAMA_BASE_URL=http://ollama:11434
ENV TUTOR_RESPONSE_LLM_ENABLED=true
ENV EMBEDDING_BACKEND=ollama
ENV OLLAMA_EMBEDDING_MODEL=nomic-embed-text

WORKDIR /workspace

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY chatbot.py .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=5).read()" || exit 1

CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
